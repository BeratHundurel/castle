{
  "$schema": "https://github.com/longbridge/gpui-component/raw/refs/heads/main/.theme-schema.json",
  "name": "Twilight",
  "author": "MacroMates",
  "url": "https://macromates.com",
  "themes": [
    {
      "name": "Twilight",
      "mode": "dark",
      "colors": {
        "accent.background": "#2b2b2b",
        "accent.foreground": "#dcdcdc",
        "background": "#141414",
        "border": "#343434",
        "foreground": "#dcdcdc",
        "input.border": "#3e3e3e",
        "list.active.background": "#CDA86911",
        "list.active.border": "#CDA86988",
        "list.even.background": "#1E1E1E99",
        "muted.background": "#2e2e2e88",
        "muted.foreground": "#828282",
        "primary.background": "#CDA869",
        "primary.foreground": "#1e1e1e",
        "scrollbar.background": "#1e1e1e00",
        "scrollbar.thumb.background": "#3e3e3e",
        "secondary.background": "#262626",
        "secondary.active.background": "#2a2a2a",
        "secondary.foreground": "#dcdcdc",
        "secondary.hover.background": "#272727",
        "tab.active.background": "#141414",
        "tab.active.foreground": "#dcdcdc",
        "tab.background": "#1E1E1E00",
        "tab.foreground": "#A9A9A9",
        "tab_bar.background": "#1E1E1E",
        "table.background": "#1e1e1e00",
        "title_bar.background": "#1e1e1e",
        "title_bar.border": "#343434",
        "base.red": "#c06d44",
        "base.red.light": "#de7c4c",
        "base.green": "#afb97a",
        "base.green.light": "#ccd88c",
        "base.yellow": "#c2a86c",
        "base.yellow.light": "#e2c47e",
        "base.blue": "#44474a",
        "base.blue.light": "#5a5e62",
        "base.magenta": "#b4be7c",
        "base.magenta.light": "#d0dc8e99",
        "base.cyan": "#778385",
        "base.cyan.light": "#8a989b"
      },
      "highlight": {
        "editor.foreground": "#dcdcdc",
        "editor.background": "#141414",
        "editor.active_line.background": "#1E1E1E",
        "editor.line_number": "#828282",
        "editor.active_line_number": "#dcdcdc",
        "editor.invisible": "#82828266",
        "conflict": "#c06d44",
        "created": "#afb97a",
        "deleted": "#c06d44",
        "error": "#c06d44",
        "hidden": "#828282",
        "hint": "#778385",
        "ignored": "#828282",
        "info": "#8a989b",
        "modified": "#c2a86c",
        "predictive": "#828282",
        "renamed": "#8a989b",
        "success": "#afb97a",
        "unreachable": "#828282",
        "warning": "#c2a86c",
        "syntax": {
          "attribute": {
            "color": "#CDA869"
          },
          "boolean": {
            "color": "#CF6A4C"
          },
          "comment": {
            "color": "#5F5A60",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "#5F5A60",
            "font_style": "italic"
          },
          "constant": {
            "color": "#CF6A4C"
          },
          "constructor": {
            "color": "#9B859D"
          },
          "embedded": {
            "color": "#dcdcdc"
          },
          "function": {
            "color": "#9B703F"
          },
          "keyword": {
            "color": "#CDA869"
          },
          "link_text": {
            "color": "#8A989B",
            "font_style": "underline"
          },
          "link_uri": {
            "color": "#778385",
            "font_style": "italic"
          },
          "number": {
            "color": "#CF6A4C"
          },
          "string": {
            "color": "#8F9D6A"
          },
          "string.escape": {
            "color": "#D2A8A1"
          },
          "string.regex": {
            "color": "#E9C062"
          },
          "string.special": {
            "color": "#CF6A4C"
          },
          "string.special.symbol": {
            "color": "#9B859D"
          },
          "tag": {
            "color": "#CDA869"
          },
          "text.literal": {
            "color": "#8F9D6A"
          },
          "title": {
            "color": "#CDA869",
            "font_weight": 600
          },
          "type": {
            "color": "#9B859D"
          },
          "property": {
            "color": "#dcdcdc"
          },
          "variable.special": {
            "color": "#CF6A4C"
          }
        }
      }
    }
  ]
}
