<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
>
  <Package
        Name="Castle"
        Manufacturer="Castle"
        Version="$(Version)"
        UpgradeCode="$(UpgradeCode)"
        Scope="perMachine"
        Compressed="yes"
    >
    <MajorUpgrade
            DowngradeErrorMessage="A newer version of Castle is already installed."
        />
    <Icon Id="Castle.exe" SourceFile="$(SourceIcon)" />
    <WixVariable Id="WixUILicenseRtf" Value="$(SourceLicenseRtf)" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Castle">
        <Component Id="CastleExecutable" Guid="*">
          <File
                        Id="CastleExe"
                        Source="$(SourceExe)"
                        Name="Castle.exe"
                        KeyPath="yes"
                    >
            <Shortcut
                            Id="CastleStartMenuShortcut"
                            Directory="ProgramMenuFolder"
                            Name="Castle"
                            Description="Private notes and kanban workspace"
                            WorkingDirectory="INSTALLFOLDER"
                            Advertise="yes"
                            Icon="Castle.exe"
                            IconIndex="0"
                        >
              <ShortcutProperty
                                Key="System.AppUserModel.ID"
                                Value="Castle.App"
                            />
            </Shortcut>
          </File>
        </Component>
        <Component Id="CastleMcpExecutable" Guid="*">
          <File
                        Id="CastleMcpExe"
                        Source="$(SourceMcpExe)"
                        Name="Castle-MCP.exe"
                        KeyPath="yes"
                    />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="MainFeature" Title="Castle" Level="1">
      <ComponentRef Id="CastleExecutable" />
    </Feature>

    <Feature
            Id="McpFeature"
            Title="Castle MCP Server"
            Description="Install the optional MCP helper for agent access. You can enable agent access later in Castle Settings."
            Level="2"
            AllowAbsent="yes"
        >
      <ComponentRef Id="CastleMcpExecutable" />
    </Feature>
  </Package>
</Wix>
